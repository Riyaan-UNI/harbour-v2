{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "types": ["vite/client"],

    /* shadcn/ui is written against the `@/` alias, so the alias exists even
       though this project's own imports stay relative. */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      /* The ported legacy lane. `@legacy/*` resolves to the real file for
         Vite, and to the ambient declarations in `src/legacy.d.ts` for tsc —
         which is what lets a `.tsx` file import a legacy `.jsx` without the
         strict project trying to type-check it. */
      "@legacy/*": ["src/legacy/*"]
    },

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "allowUnreachableCode": false,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,

    /* The legacy lane (`src/legacy/**`) is plain JSX ported from the old build
       and is deliberately excluded from `include` below. TypeScript never sees
       it, so its JSX compiles through Vite only, and the strict rules above
       apply to new code and nothing else. `allowJs` is off for the same
       reason: turning it on would pull those files back in through imports. */
    "allowJs": false
  },
  "include": ["src"],
  "exclude": ["src/legacy"]
}
