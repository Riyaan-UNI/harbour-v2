{
  "name": "harbour",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Harbour - a safe harbour for international students in Hong Kong. Brick 0: foundation.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "check:public-assets": "node scripts/check-public-asset-urls.mjs",
    "check:pages-build": "node scripts/check-pages-build.mjs",
    "sync:flags": "node scripts/sync-flags.mjs",
    "build:university-art": "node scripts/build-university-art.mjs",
    "dev:server": "node server/index.js",
    "dev:web": "vite"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/noto-sans-tc": "5.3.1",
    "@gsap/react": "2.1.2",
    "@radix-ui/react-dialog": "1.3.0",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "concurrently": "10.0.6",
    "gsap": "3.15.0",
    "i18n-iso-countries": "7.14.0",
    "lenis": "1.3.26",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "flag-icons": "7.5.0",
    "globals": "17.13.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
